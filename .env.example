# ---------------------------------------------------------------------------
# WYŁĄCZNIE WARTOŚCI PRZYKŁADOWE DO LOCAL DEV.
# Ten plik trafia do repozytorium i NIE zawiera żadnego prawdziwego sekretu.
# Prawdziwe wartości produkcyjne żyją jako zmienne środowiskowe Lambdy w AWS.
# Skopiuj ten plik do .env (który jest w .gitignore) i dostosuj lokalnie.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Baza z docker-compose.yml, nie produkcyjny RDS.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zoja
DB_USER=postgres
DB_PASSWORD=change-me

# Lokalny Postgres w kontenerze nie ma TLS-a. W AWS ustaw DB_SSL=true.
DB_SSL=false

# Mała pula — patrz README, sekcja o połączeniach i współbieżności Lambdy.
DB_POOL_MAX=2

# Logowanie zapytań TypeORM. Na produkcji zostaw false.
DB_LOGGING=false
